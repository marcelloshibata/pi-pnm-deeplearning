<%
  // Dados enviados pelo controller. Se faltarem, a página renderiza vazia.
  const medico = locals.medico || {};
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { title: 'DPRT | Meu perfil' }) %>
</head>
<body class="dashboard-page">
  <header class="navbar">
    <a class="brand navbar__brand" href="/exames">
      <span class="brand__icon">
        <span class="navbar__logo"><img src="/imgs/lung-icon-blue.svg" alt="" width="19.7752" height="25.4075"></span>
      </span>
      <span class="brand__name">DPRT</span>
    </a>

    <nav class="navbar__links">
      <a href="/pacientes">Pacientes</a>
      <a href="/exames">Exames</a>
    </nav>

    <div class="navbar__profile">
      <% if (locals.usuario && usuario.nome) { %>
        <span class="navbar__user-name"><%= usuario.nome %></span>
      <% } %>
      <a class="avatar" href="/perfil" aria-label="Perfil<%= locals.usuario ? ' de ' + usuario.nome : '' %>" aria-current="page">
        <% if (locals.fotoPerfil) { %>
          <img class="avatar__img" src="<%= fotoPerfil %>" alt="">
        <% } else { %>
          <img src="/imgs/user-icon.svg" alt="" width="18" height="18">
        <% } %>
      </a>
    </div>
  </header>

  <main class="dashboard profile">
    <div class="profile__content">
      <nav class="breadcrumb" aria-label="Caminho da página">
        <a class="breadcrumb__link" href="/pacientes">
          <img src="/imgs/arrow-left-blue.svg" alt="" width="16" height="16">
          Voltar para pacientes
        </a>
        <span class="breadcrumb__separator">/</span>
        <span class="breadcrumb__current">Meu perfil</span>
      </nav>

      <div class="profile__heading">
        <h1 class="profile__title">Meu perfil</h1>
        <p class="profile__subtitle">Suas informações profissionais reunidas em um só lugar.</p>
      </div>

      <section class="profile-card">
        <div class="profile-card__header">
          <div class="profile-card__identity">
            <span class="profile-card__symbol">
              <img src="/imgs/contact-round-icon.svg" alt="" width="20" height="20">
            </span>
            <h2 class="profile-card__title">Informações profissionais</h2>
          </div>
          <span class="profile-card__tag">Perfil médico</span>
        </div>

        <div class="profile-card__body">
          <form class="profile-photo" action="/perfil/foto" method="POST" enctype="multipart/form-data">
            <label class="profile-photo__circle" for="perfil-foto" title="Alterar foto">
              <% if (medico.foto) { %>
                <img class="profile-photo__img" src="<%= medico.foto %>" alt="Foto de <%= medico.nome %>">
              <% } else { %>
                <svg width="82" height="82" viewBox="0 0 24 24" fill="#c9c9c9" stroke="#000" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14.5 4h-5L7.5 7H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2.5z"/>
                  <circle cx="12" cy="13" r="3.5" fill="#fff"/>
                  <circle cx="17.5" cy="10" r="0.5" fill="#000"/>
                </svg>
              <% } %>
            </label>
            <input id="perfil-foto" type="file" name="foto" accept="image/png,image/jpeg,image/webp" hidden onchange="this.form.submit()">
          </form>

          <div class="profile-identification">
            <h2 class="profile-identification__name"><%= medico.nome || '' %></h2>
            <p class="profile-identification__meta">Médico • DPRT</p>
          </div>

          <div class="profile-fields">
            <div class="profile-field profile-field--name">
              <label class="profile-field__label" for="perfil-nome">Nome completo</label>
              <input class="profile-field__input" id="perfil-nome" type="text" value="<%= medico.nome || '' %>" readonly>
            </div>
            <div class="profile-field">
              <label class="profile-field__label" for="perfil-crm">CRM</label>
              <input class="profile-field__input" id="perfil-crm" type="text" value="<%= medico.crm || '' %>" readonly>
            </div>
            <div class="profile-field">
              <label class="profile-field__label" for="perfil-instituicao">Instituição</label>
              <input class="profile-field__input" id="perfil-instituicao" type="text" value="<%= medico.instituicao || '' %>" readonly>
            </div>
          </div>
        </div>
      </section>

      <section class="session-card">
        <div class="session-card__info">
          <span class="session-card__symbol">
            <img src="/imgs/shield-check-blue.svg" alt="" width="22" height="22">
          </span>
          <div>
            <h2 class="session-card__title">Sua sessão</h2>
            <p class="session-card__text">Ao terminar, saia da conta para manter seus dados protegidos.</p>
          </div>
        </div>
        <a class="session-card__logout" href="/logout">Sair da conta</a>
      </section>
    </div>
  </main>

  <%- include('partials/error-modal') %>
</body>
</html>
