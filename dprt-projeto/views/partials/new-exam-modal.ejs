<dialog class="error-modal exam-modal" id="exam-modal" aria-labelledby="exam-modal-title" aria-describedby="exam-modal-description">
  <form class="exam-form" action="/exames/cadastrar" method="post" enctype="multipart/form-data">
    <div class="exam-modal__header">
      <div>
        <h2 class="exam-modal__title" id="exam-modal-title">Novo exame</h2>
        <p class="exam-modal__description" id="exam-modal-description">Cadastre os dados do paciente e vincule uma imagem ao exame.</p>
      </div>
      <button class="exam-modal__close" type="button" aria-label="Fechar" data-close-modal>
        <img src="/imgs/x-icon.svg" alt="" width="18" height="18">
      </button>
    </div>

    <div class="exam-modal__body">
      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/user-round-icon.svg" alt="" width="18" height="18">
          Paciente
        </legend>

        <div class="combobox" id="exame-paciente-combobox">
          <input type="hidden" id="exame-paciente-id" name="pacienteId">
          <input class="field__input field__input--exam field__input--select" type="text" id="exame-paciente" placeholder="Pesquisar paciente por nome ou CPF" aria-label="Paciente" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="exame-paciente-lista" autocomplete="off" required autofocus>
          <ul class="combobox__list" id="exame-paciente-lista" role="listbox" hidden></ul>
        </div>
      </fieldset>

      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/clipboard-list-icon.svg" alt="" width="18" height="18">
          Dados do exame
        </legend>

        <div class="field">
          <label class="field__label field__label--exam" for="exame-data">Data do exame</label>
          <input class="field__input field__input--exam field__input--date" type="date" id="exame-data" name="dataExame" required>
        </div>
      </fieldset>

      <fieldset class="exam-form__section exam-form__section--upload">
        <legend class="exam-form__section-title">
          <img src="/imgs/image-icon.svg" alt="" width="18" height="18">
          Anexar imagem ao exame
        </legend>

        <label class="dropzone" for="exame-imagem">
          <span class="dropzone__icon">
            <img src="/imgs/upload-icon.svg" alt="" width="22" height="22">
          </span>
          <span class="dropzone__text">
            <span class="dropzone__title">Arraste uma imagem para esta área</span>
            <span class="dropzone__hint">PNG ou JPG • Até 4 MB por arquivo</span>
          </span>
          <span class="dropzone__button">Selecionar imagem</span>
          <input class="dropzone__input" type="file" id="exame-imagem" name="imagem" accept="image/png,image/jpeg" required>
        </label>

        <p class="dropzone__status" id="exame-imagem-status">Nenhuma imagem anexada. O arquivo será vinculado ao registro do paciente.</p>
      </fieldset>
    </div>

    <div class="exam-modal__footer">
      <p class="exam-modal__privacy">
        <img src="/imgs/shield-check-icon.svg" alt="" width="16" height="16">
        Dados protegidos e acesso restrito à equipe do hospital. 
      </p>
      <div class="exam-modal__actions">
        <button class="btn exam-modal__cancel" type="button" data-close-modal>Cancelar</button>
        <button class="btn btn--primary exam-modal__submit" type="submit">Cadastrar exame</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  const examModal = document.getElementById('exam-modal');
  const examForm = examModal.querySelector('.exam-form');
  const dropzone = examModal.querySelector('.dropzone');
  const imageInput = document.getElementById('exame-imagem');
  const imageStatus = document.getElementById('exame-imagem-status');
  const defaultImageStatus = imageStatus.textContent;

  document.querySelectorAll('[data-open-exam-modal]').forEach((button) => {
    button.addEventListener('click', () => examModal.showModal());
  });

  examModal.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => examModal.close());
  });

  // Ao fechar, limpa o formulário para o próximo cadastro
  examModal.addEventListener('close', () => {
    examForm.reset();
    pacienteId.value = '';
    pacienteInput.setCustomValidity('');
    fecharLista();
    imageStatus.textContent = defaultImageStatus;
  });

  imageInput.addEventListener('change', () => {
    const arquivo = imageInput.files[0];
    imageStatus.textContent = arquivo ? `Imagem selecionada: ${arquivo.name}` : defaultImageStatus;
  });

  // Pesquisa de paciente: digita para filtrar os cadastrados e escolhe um da lista
  const pacienteInput = document.getElementById('exame-paciente');
  const pacienteId = document.getElementById('exame-paciente-id');
  const pacienteLista = document.getElementById('exame-paciente-lista');
  const mensagemSelecao = 'Selecione um paciente da lista.';
  let opcaoAtiva = -1;
  let temporizador;
  let ultimaBusca = 0;

  function fecharLista() {
    pacienteLista.hidden = true;
    pacienteInput.setAttribute('aria-expanded', 'false');
    opcaoAtiva = -1;
  }

  function marcarOpcao(indice) {
    const opcoes = pacienteLista.querySelectorAll('[role="option"]');
    opcoes.forEach((opcao, i) => opcao.classList.toggle('combobox__option--active', i === indice));
    opcaoAtiva = indice;
    if (opcoes[indice]) opcoes[indice].scrollIntoView({ block: 'nearest' });
  }

  function escolherPaciente(paciente) {
    pacienteId.value = paciente.id;
    pacienteInput.value = paciente.nome;
    pacienteInput.setCustomValidity('');
    fecharLista();
  }

  function mostrarPacientes(pacientes) {
    pacienteLista.replaceChildren();

    if (pacientes.length === 0) {
      const vazio = document.createElement('li');
      vazio.className = 'combobox__empty';
      vazio.textContent = 'Nenhum paciente encontrado.';
      pacienteLista.append(vazio);
    }

    pacientes.forEach((paciente) => {
      const item = document.createElement('li');
      item.className = 'combobox__option';
      item.setAttribute('role', 'option');

      const nome = document.createElement('span');
      nome.className = 'combobox__name';
      nome.textContent = paciente.nome;

      const detalhes = document.createElement('span');
      detalhes.className = 'combobox__meta';
      detalhes.textContent = `${paciente.cpf} • ${paciente.idade} anos • ${paciente.sexo}`;

      item.append(nome, detalhes);
      // mousedown acontece antes do blur do campo, então o clique não se perde
      item.addEventListener('mousedown', (event) => {
        event.preventDefault();
        escolherPaciente(paciente);
      });
      pacienteLista.append(item);
    });

    pacienteLista.hidden = false;
    pacienteInput.setAttribute('aria-expanded', 'true');
    opcaoAtiva = -1;
  }

  function buscarPacientes() {
    const busca = ++ultimaBusca;
    fetch(`/pacientes/buscar?q=${encodeURIComponent(pacienteInput.value.trim())}`)
      .then((resposta) => (resposta.ok ? resposta.json() : Promise.reject(resposta.status)))
      .then((pacientes) => {
        // Ignora respostas antigas que chegaram depois de uma busca mais nova
        if (busca === ultimaBusca) mostrarPacientes(pacientes);
      })
      .catch(() => fecharLista());
  }

  pacienteInput.addEventListener('input', () => {
    // Mudou o texto: o paciente escolhido antes deixa de valer
    pacienteId.value = '';
    pacienteInput.setCustomValidity(pacienteInput.value ? mensagemSelecao : '');
    clearTimeout(temporizador);
    temporizador = setTimeout(buscarPacientes, 250);
  });

  pacienteInput.addEventListener('focus', buscarPacientes);
  pacienteInput.addEventListener('blur', fecharLista);

  pacienteInput.addEventListener('keydown', (event) => {
    const opcoes = pacienteLista.querySelectorAll('[role="option"]');
    if (event.key === 'ArrowDown' && opcoes.length) {
      event.preventDefault();
      marcarOpcao((opcaoAtiva + 1) % opcoes.length);
    } else if (event.key === 'ArrowUp' && opcoes.length) {
      event.preventDefault();
      marcarOpcao((opcaoAtiva - 1 + opcoes.length) % opcoes.length);
    } else if (event.key === 'Enter' && opcaoAtiva >= 0) {
      event.preventDefault();
      opcoes[opcaoAtiva].dispatchEvent(new MouseEvent('mousedown', { cancelable: true }));
    } else if (event.key === 'Escape' && !pacienteLista.hidden) {
      // Fecha só a lista, sem fechar o modal
      event.preventDefault();
      event.stopPropagation();
      fecharLista();
    }
  });

  // Arrastar e soltar a imagem na área de upload
  dropzone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropzone.classList.add('dropzone--active');
  });

  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dropzone--active'));

  dropzone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropzone.classList.remove('dropzone--active');
    if (event.dataTransfer.files.length) {
      imageInput.files = event.dataTransfer.files;
      imageInput.dispatchEvent(new Event('change'));
    }
  });
</script>
