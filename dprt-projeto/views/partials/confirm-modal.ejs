<dialog class="confirm-modal" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-modal-title" aria-describedby="confirm-modal-message">
  <div class="confirm-modal__alert">
    <img src="/imgs/circle-alert.svg" alt="" width="36" height="36">
  </div>

  <h2 class="confirm-modal__title" id="confirm-modal-title">Confirmar edição</h2>
  <p class="confirm-modal__message" id="confirm-modal-message">Deseja realmente salvar as alterações nos dados deste paciente?</p>

  <div class="confirm-modal__footer">
    <button class="btn confirm-modal__btn" type="button" data-cancel>Cancelar</button>
    <button class="btn confirm-modal__btn" type="button" id="confirm-button" data-confirm>Confirmar</button>
  </div>
</dialog>

<script>
  const confirmModal = document.getElementById('confirm-modal');

  let onConfirm = null;

  function abrirConfirmacao({ titulo, mensagem, aoConfirmar }) {
    document.getElementById('confirm-modal-title').textContent = titulo;
    document.getElementById('confirm-modal-message').textContent = mensagem;

    if (titulo === 'Confirmar exclusão') {
      document.getElementById('confirm-button').style.backgroundColor = '#D34A43'
    } else {
      document.getElementById('confirm-button').style.backgroundColor = ''
    }

    onConfirm = aoConfirmar;
    confirmModal.showModal();
  }

  confirmModal.querySelector('[data-cancel]').addEventListener('click', event => {
    confirmModal.close();
  })

  confirmModal.querySelector('[data-confirm]').addEventListener('click', event => {
    confirmModal.close();
    if (onConfirm) onConfirm();
  })
  
  // Fecha ao clicar fora do modal (no backdrop)
  confirmModal.addEventListener('click', (event) => {
    if (event.target === confirmModal) confirmModal.close();
  });
</script>
