<dialog class="error-modal exam-modal exam-view patient-view" id="patient-view-modal" aria-labelledby="patient-view-modal-title" aria-describedby="patient-view-modal-description">
  <div class="exam-form">
    <div class="exam-modal__header">
      <div>
        <h2 class="exam-modal__title" id="patient-view-modal-title">Detalhes do paciente</h2>
        <p class="exam-modal__description" id="patient-view-modal-description">Dados pessoais, contato e endereço do paciente.</p>
      </div>
      <button class="exam-modal__close" type="button" aria-label="Fechar" data-close-modal>
        <img src="/imgs/x-icon.svg" alt="" width="18" height="18">
      </button>
    </div>

    <div class="exam-modal__body">
      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/user-round-icon.svg" alt="" width="18" height="18">
          Dados pessoais
        </legend>

        <div class="exam-form__row exam-form__row--name">
          <div class="field">
            <span class="field__label field__label--exam">Nome completo</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="nome">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Idade</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="idade">—</output>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <span class="field__label field__label--exam">CPF</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="cpf">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">RG</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="rg">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Sexo biológico</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="sexo">—</output>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <span class="field__label field__label--exam">Tipo sanguíneo</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="tipoSanguineo">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Cor ou raça</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="etnia">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Nome social</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="nomeSocial">—</output>
          </div>
        </div>
      </fieldset>

      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/clipboard-list-icon.svg" alt="" width="18" height="18">
          Contato
        </legend>

        <div class="exam-form__row exam-form__row--2">
          <div class="field">
            <span class="field__label field__label--exam">Celular</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="contato">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">E-mail</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="email">—</output>
          </div>
        </div>
      </fieldset>

      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/selecao-icon.svg" alt="" width="18" height="18">
          Endereço
        </legend>

        <div class="exam-form__row patient-form__row--street">
          <div class="field">
            <span class="field__label field__label--exam">CEP</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="cep">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Logradouro</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="logradouro">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Número</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="numero">—</output>
          </div>
        </div>

        <div class="exam-form__row patient-form__row--city">
          <div class="field">
            <span class="field__label field__label--exam">Bairro</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="bairro">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Cidade</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="cidade">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">UF</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="estado">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Complemento</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="complemento">—</output>
          </div>
        </div>
      </fieldset>
    </div>

    <div class="exam-modal__footer">
      <p class="exam-modal__privacy">
        <img src="/imgs/shield-check-icon.svg" alt="" width="16" height="16">
        Dados protegidos e acesso restrito à equipe assistencial.
      </p>
      <div class="exam-modal__actions patient-modal__actions--single">
        <button class="btn btn--primary exam-modal__submit" type="button" data-close-modal>Fechar</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const patientViewModal = document.getElementById('patient-view-modal');

  function abrirPaciente(paciente) {
    patientViewModal.querySelectorAll('[data-campo]').forEach((campo) => {
      campo.textContent = paciente[campo.dataset.campo] || '—';
    });
    patientViewModal.showModal();
  }

  document.querySelectorAll('[data-paciente]').forEach((linha) => {
    const paciente = JSON.parse(linha.dataset.paciente);
    linha.addEventListener('click', (event) => {
      if (event.target.closest('a, button')) return;
      abrirPaciente(paciente);
    });
  });

  patientViewModal.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => patientViewModal.close());
  });

  patientViewModal.addEventListener('click', (event) => {
    if (event.target === patientViewModal) patientViewModal.close();
  });
</script>
