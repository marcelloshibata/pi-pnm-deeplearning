<dialog class="error-modal exam-modal" id="exam-modal" aria-labelledby="exam-modal-title" aria-describedby="exam-modal-description">
  <form class="exam-form" action="/exames/cadastrar" method="post" enctype="multipart/form-data">
    <div class="exam-modal__header">
      <div>
        <h2 class="exam-modal__title" id="exam-modal-title">Novo exame</h2>
        <p class="exam-modal__description" id="exam-modal-description">Cadastre os dados do paciente e vincule uma imagem ao exame.</p>
      </div>
      <button class="exam-modal__close" type="button" aria-label="Fechar" data-close-modal>
        <img src="/imgs/x-icon.svg" alt="" width="18" height="18">
      </button>
    </div>

    <div class="exam-modal__body">
      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/user-round-icon.svg" alt="" width="18" height="18">
          Dados do paciente
        </legend>

        <div class="exam-form__row exam-form__row--name">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-nome">Nome</label>
            <input class="field__input field__input--exam" type="text" id="paciente-nome" name="nome" placeholder="Mariana Oliveira" autocomplete="off" required autofocus>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-idade">Idade</label>
            <input class="field__input field__input--exam" type="number" id="paciente-idade" name="idade" placeholder="37" min="0" max="130" required>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-sangue">Tipo sanguíneo</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-sangue" name="tipoSanguineo" required>
              <option value="" disabled selected hidden>Selecione</option>
              <option>A+</option>
              <option>A-</option>
              <option>B+</option>
              <option>B-</option>
              <option>AB+</option>
              <option>AB-</option>
              <option>O+</option>
              <option>O-</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-etnia">Etnia</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-etnia" name="etnia" required>
              <option value="" disabled selected hidden>Selecione</option>
              <option>Branca</option>
              <option>Preta</option>
              <option>Parda</option>
              <option>Amarela</option>
              <option>Indígena</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-sexo">Sexo biológico</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-sexo" name="sexo" required>
              <option value="" disabled selected hidden>Selecione</option>
              <option>Feminino</option>
              <option>Masculino</option>
            </select>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--2">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-rg">RG</label>
            <input class="field__input field__input--exam" type="text" id="paciente-rg" name="rg" placeholder="00.000.000-0" maxlength="12" pattern="\d{2}\.\d{3}\.\d{3}-[\dX]" title="Informe o RG completo no formato 00.000.000-0" autocomplete="off" required data-mask="rg">
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-cpf">CPF</label>
            <input class="field__input field__input--exam" type="text" id="paciente-cpf" name="cpf" placeholder="000.000.000-00" maxlength="14" pattern="\d{3}\.\d{3}\.\d{3}-\d{2}" title="Informe o CPF completo no formato 000.000.000-00" inputmode="numeric" autocomplete="off" required data-mask="cpf">
          </div>
        </div>
      </fieldset>

      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/clipboard-list-icon.svg" alt="" width="18" height="18">
          Dados do exame
        </legend>

        <div class="exam-form__row exam-form__row--2">
          <div class="field">
            <label class="field__label field__label--exam" for="exame-tipo">Tipo de exame</label>
            <select class="field__input field__input--exam field__input--select" id="exame-tipo" name="tipoExame" required>
              <option>RX de tórax</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="exame-data">Data do exame</label>
            <input class="field__input field__input--exam field__input--date" type="date" id="exame-data" name="dataExame" required>
          </div>
        </div>
      </fieldset>

      <fieldset class="exam-form__section exam-form__section--upload">
        <legend class="exam-form__section-title">
          <img src="/imgs/image-icon.svg" alt="" width="18" height="18">
          Anexar imagem ao exame
        </legend>

        <label class="dropzone" for="exame-imagem">
          <span class="dropzone__icon">
            <img src="/imgs/upload-icon.svg" alt="" width="22" height="22">
          </span>
          <span class="dropzone__text">
            <span class="dropzone__title">Arraste uma imagem para esta área</span>
            <span class="dropzone__hint">PNG ou JPG • Até 4 MB por arquivo</span>
          </span>
          <span class="dropzone__button">Selecionar imagem</span>
          <input class="dropzone__input" type="file" id="exame-imagem" name="imagem" accept="image/png,image/jpeg" required>
        </label>

        <p class="dropzone__status" id="exame-imagem-status">Nenhuma imagem anexada. O arquivo será vinculado ao registro do paciente.</p>
      </fieldset>
    </div>

    <div class="exam-modal__footer">
      <p class="exam-modal__privacy">
        <img src="/imgs/shield-check-icon.svg" alt="" width="16" height="16">
        Dados fictícios • Documentos mascarados
      </p>
      <div class="exam-modal__actions">
        <button class="btn exam-modal__cancel" type="button" data-close-modal>Cancelar</button>
        <button class="btn btn--primary exam-modal__submit" type="submit">Cadastrar exame</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  const examModal = document.getElementById('exam-modal');
  const examForm = examModal.querySelector('.exam-form');
  const dropzone = examModal.querySelector('.dropzone');
  const imageInput = document.getElementById('exame-imagem');
  const imageStatus = document.getElementById('exame-imagem-status');
  const defaultImageStatus = imageStatus.textContent;

  document.querySelectorAll('[data-open-exam-modal]').forEach((button) => {
    button.addEventListener('click', () => examModal.showModal());
  });

  examModal.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => examModal.close());
  });

  // Ao fechar, limpa o formulário para o próximo cadastro
  examModal.addEventListener('close', () => {
    examForm.reset();
    imageStatus.textContent = defaultImageStatus;
  });

  imageInput.addEventListener('change', () => {
    const arquivo = imageInput.files[0];
    imageStatus.textContent = arquivo ? `Imagem selecionada: ${arquivo.name}` : defaultImageStatus;
  });

  // Máscaras de RG e CPF: cada "0" do padrão recebe um caractere digitado
  const mascaras = {
    rg: {
      padrao: '00.000.000-0',
      // O dígito verificador do RG pode ser "X", então ele só é aceito na última posição
      limpar: (valor) => {
        let limpo = '';
        for (const char of valor.toUpperCase()) {
          if (limpo.length === 9) break;
          if (/\d/.test(char) || (char === 'X' && limpo.length === 8)) limpo += char;
        }
        return limpo;
      },
    },
    cpf: {
      padrao: '000.000.000-00',
      limpar: (valor) => valor.replace(/\D/g, '').slice(0, 11),
    },
  };

  function aplicarMascara(valor, padrao) {
    let formatado = '';
    let i = 0;
    for (const char of padrao) {
      // Para antes de colocar um separador sem número depois dele
      if (i >= valor.length) break;
      formatado += char === '0' ? valor[i++] : char;
    }
    return formatado;
  }

  examModal.querySelectorAll('[data-mask]').forEach((input) => {
    const { padrao, limpar } = mascaras[input.dataset.mask];

    input.addEventListener('input', () => {
      // Guarda quantos caracteres válidos havia antes do cursor, para ele não pular para o fim ao editar no meio
      const antesDoCursor = limpar(input.value.slice(0, input.selectionStart)).length;
      const formatado = aplicarMascara(limpar(input.value), padrao);
      input.value = formatado;

      let posicao = 0;
      let contados = 0;
      while (posicao < formatado.length && contados < antesDoCursor) {
        if (/[\dX]/.test(formatado[posicao])) contados++;
        posicao++;
      }
      input.setSelectionRange(posicao, posicao);
    });
  });

  // Arrastar e soltar a imagem na área de upload
  dropzone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropzone.classList.add('dropzone--active');
  });

  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dropzone--active'));

  dropzone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropzone.classList.remove('dropzone--active');
    if (event.dataTransfer.files.length) {
      imageInput.files = event.dataTransfer.files;
      imageInput.dispatchEvent(new Event('change'));
    }
  });
</script>
