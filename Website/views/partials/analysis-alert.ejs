<% if (locals.analise) { %>
<!-- Alerta no estilo do Bootstrap; a cor vem de analise.nivel ("danger", "warning" ou "success") -->
<!-- data-exame-id diz a qual exame o alerta pertence, para ele só aparecer no modal desse exame -->
<div class="alert alert--<%= analise.nivel %>" id="analysis-alert" role="alert" data-exame-id="<%= analise.exameId %>">
  <p class="alert__message"><%= analise.mensagem %></p>
  <button class="alert__close" type="button" aria-label="Fechar" onclick="this.parentElement.remove()">
    <img src="/imgs/x-icon.svg" alt="" width="16" height="16">
  </button>
</div>
<% } %>
