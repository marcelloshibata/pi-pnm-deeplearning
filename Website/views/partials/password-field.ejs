<div class="field<%= typeof modifier !== 'undefined' ? ' ' + modifier : '' %>">
  <label class="field__label" for="<%= id %>"><%= label %></label>
  <div class="field__wrap">
    <input class="field__input field__input--password" type="password" id="<%= id %>" name="<%= id %>" placeholder="••••••••" autocomplete="<%= autocomplete %>">
    <button class="field__toggle" type="button" aria-label="Mostrar senha" data-target="<%= id %>">
      <img src="/imgs/eye-icon.svg" alt="" width="18" height="18">
    </button>
  </div>
</div>
