<dialog class="error-modal exam-modal patient-modal" id="patient-modal" aria-labelledby="patient-modal-title" aria-describedby="patient-modal-description">
  <form class="exam-form" action="/pacientes/cadastrar" method="post">
    <div class="exam-modal__header patient-modal__header">
      <span class="patient-modal__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 21a8 8 0 0 1 13.292-6"/><circle cx="10" cy="8" r="5"/><path d="M19 16v6"/><path d="M22 19h-6"/></svg>
      </span>
      <div class="patient-modal__heading">
        <h2 class="exam-modal__title" id="patient-modal-title">Cadastrar paciente</h2>
        <p class="exam-modal__description" id="patient-modal-description">Adicione um paciente sem sair da sua lista.</p>
      </div>
      <button class="exam-modal__close" type="button" aria-label="Fechar" data-close-modal>
        <img src="/imgs/x-icon.svg" alt="" width="18" height="18">
      </button>
    </div>

    <div class="exam-modal__body">
      <section class="exam-form__section">
        <div class="patient-form__heading">
          <h3 class="exam-form__section-title">Dados pessoais</h3>
          <p class="patient-form__required">* Campos obrigatórios</p>
        </div>

        <div class="exam-form__row patient-form__row--name">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-nome">Nome completo *</label>
            <input class="field__input field__input--exam" type="text" id="paciente-nome" name="nome" autocomplete="off" required autofocus>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-nascimento">Data de nascimento *</label>
            <input class="field__input field__input--exam field__input--date" type="date" id="paciente-nascimento" name="dataNascimento" required>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-cpf">CPF *</label>
            <input class="field__input field__input--exam" type="text" id="paciente-cpf" name="cpf" placeholder="000.000.000-00" maxlength="14" pattern="\d{3}\.\d{3}\.\d{3}-\d{2}" title="Informe o CPF completo no formato 000.000.000-00" inputmode="numeric" autocomplete="off" required data-mask="cpf">
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-rg">RG</label>
            <input class="field__input field__input--exam" type="text" id="paciente-rg" name="rg" placeholder="00.000.000-0" maxlength="12" pattern="\d{2}\.\d{3}\.\d{3}-[\dX]" title="Informe o RG completo no formato 00.000.000-0" autocomplete="off" data-mask="rg">
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-sexo">Sexo biológico *</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-sexo" name="sexo" required>
              <option value="" disabled selected hidden>Selecione</option>
              <option>Feminino</option>
              <option>Masculino</option>
            </select>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-sangue">Tipo sanguíneo *</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-sangue" name="tipoSanguineo" required>
              <option value="" disabled selected hidden>Selecione</option>
              <option>A+</option>
              <option>A-</option>
              <option>B+</option>
              <option>B-</option>
              <option>AB+</option>
              <option>AB-</option>
              <option>O+</option>
              <option>O-</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-etnia">Cor ou raça (autodeclarada) *</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-etnia" name="etnia" required>
              <option value="" disabled selected hidden>Selecione</option>
              <option>Branca</option>
              <option>Preta</option>
              <option>Parda</option>
              <option>Amarela</option>
              <option>Indígena</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-nome-social">Nome social (opcional)</label>
            <input class="field__input field__input--exam" type="text" id="paciente-nome-social" name="nomeSocial" autocomplete="off">
          </div>
        </div>
      </section>

      <section class="exam-form__section">
        <h3 class="exam-form__section-title patient-form__title">Contato</h3>

        <div class="exam-form__row exam-form__row--2">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-celular">Celular *</label>
            <input class="field__input field__input--exam" type="tel" id="paciente-celular" name="celular" placeholder="(11) 90000-0000" maxlength="15" pattern="\(\d{2}\) \d{5}-\d{4}" title="Informe o celular no formato (00) 00000-0000" inputmode="numeric" autocomplete="off" required data-mask="celular">
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-email">E-mail</label>
            <input class="field__input field__input--exam" type="email" id="paciente-email" name="email" placeholder="nome@exemplo.com" autocomplete="off">
          </div>
        </div>
      </section>

      <section class="exam-form__section">
        <h3 class="exam-form__section-title patient-form__title">Endereço</h3>

        <div class="exam-form__row patient-form__row--street">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-cep">CEP *</label>
            <input class="field__input field__input--exam" type="text" id="paciente-cep" name="cep" placeholder="00000-000" maxlength="9" pattern="\d{5}-\d{3}" title="Informe o CEP no formato 00000-000" inputmode="numeric" autocomplete="off" required data-mask="cep">
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-logradouro">Logradouro *</label>
            <input class="field__input field__input--exam" type="text" id="paciente-logradouro" name="logradouro" autocomplete="off" required>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-numero">Número *</label>
            <input class="field__input field__input--exam" type="number" id="paciente-numero" name="numero" min="0" required>
          </div>
        </div>

        <div class="exam-form__row patient-form__row--city">
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-bairro">Bairro *</label>
            <input class="field__input field__input--exam" type="text" id="paciente-bairro" name="bairro" autocomplete="off" required>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-cidade">Cidade *</label>
            <input class="field__input field__input--exam" type="text" id="paciente-cidade" name="cidade" autocomplete="off" required>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-uf">UF *</label>
            <select class="field__input field__input--exam field__input--select" id="paciente-uf" name="estado" required>
              <option value="" disabled selected hidden></option>
              <% ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'].forEach((uf) => { %>
                <option><%= uf %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label class="field__label field__label--exam" for="paciente-complemento">Complemento</label>
            <input class="field__input field__input--exam" type="text" id="paciente-complemento" name="complemento" autocomplete="off">
          </div>
        </div>
      </section>
    </div>

    <div class="exam-modal__footer">
      <p class="exam-modal__privacy">
        <img src="/imgs/shield-check-icon.svg" alt="" width="16" height="16">
        Dados protegidos e acesso restrito à equipe assistencial. 
      </p>
      <div class="exam-modal__actions patient-modal__actions">
        <button class="btn exam-modal__cancel" type="button" data-close-modal>Cancelar</button>
        <button class="btn btn--primary exam-modal__submit" type="submit">Cadastrar paciente</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  const patientModal = document.getElementById('patient-modal');
  const patientForm = patientModal.querySelector('.exam-form');

  document.querySelectorAll('[data-open-patient-modal]').forEach((button) => {
    button.addEventListener('click', () => patientModal.showModal());
  });

  patientModal.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => patientModal.close());
  });

  // Ao fechar, limpa o formulário para o próximo cadastro
  patientModal.addEventListener('close', () => patientForm.reset());

  // Máscaras: cada "0" do padrão recebe um caractere digitado
  const mascarasPaciente = {
    cpf: { padrao: '000.000.000-00', max: 11 },
    rg: { padrao: '00.000.000-0', max: 9 },
    celular: { padrao: '(00) 00000-0000', max: 11 },
    cep: { padrao: '00000-000', max: 8 },
  };

  // O dígito verificador do RG pode ser "X", aceito só na última posição
  function limparMascara(tipo, valor) {
    const { max } = mascarasPaciente[tipo];
    let limpo = '';
    for (const char of valor.toUpperCase()) {
      if (limpo.length === max) break;
      if (/\d/.test(char) || (tipo === 'rg' && char === 'X' && limpo.length === max - 1)) limpo += char;
    }
    return limpo;
  }

  function aplicarMascaraPaciente(valor, padrao) {
    let formatado = '';
    let i = 0;
    for (const char of padrao) {
      if (i >= valor.length) break;
      formatado += char === '0' ? valor[i++] : char;
    }
    return formatado;
  }

  patientModal.querySelectorAll('[data-mask]').forEach((input) => {
    const tipo = input.dataset.mask;

    input.addEventListener('input', () => {
      // Guarda quantos caracteres válidos havia antes do cursor, para ele não pular para o fim ao editar no meio
      const antesDoCursor = limparMascara(tipo, input.value.slice(0, input.selectionStart)).length;
      const formatado = aplicarMascaraPaciente(limparMascara(tipo, input.value), mascarasPaciente[tipo].padrao);
      input.value = formatado;

      let posicao = 0;
      let contados = 0;
      while (posicao < formatado.length && contados < antesDoCursor) {
        if (/[\dX]/.test(formatado[posicao])) contados++;
        posicao++;
      }
      input.setSelectionRange(posicao, posicao);
    });
  });
</script>
