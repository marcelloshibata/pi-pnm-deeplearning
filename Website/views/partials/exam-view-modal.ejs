<dialog class="error-modal exam-modal exam-view" id="exam-view-modal" aria-labelledby="exam-view-modal-title" aria-describedby="exam-view-modal-description">
  <!-- Os valores são só exibidos: o formulário só serve para enviar o exame para análise -->
  <form class="exam-form" action="/exames/analisar" method="post">
    <input type="hidden" name="id">
    <input type="hidden" name="paciente">

    <div class="exam-modal__header">
      <div>
        <h2 class="exam-modal__title" id="exam-view-modal-title">Detalhes do exame</h2>
        <p class="exam-modal__description" id="exam-view-modal-description">Dados do paciente e imagem vinculada ao exame.</p>
      </div>
      <button class="exam-modal__close" type="button" aria-label="Fechar" data-close-modal>
        <img src="/imgs/x-icon.svg" alt="" width="18" height="18">
      </button>
    </div>

    <div class="exam-modal__body">
      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/user-round-icon.svg" alt="" width="18" height="18">
          Dados do paciente
        </legend>

        <div class="exam-form__row exam-form__row--name">
          <div class="field">
            <span class="field__label field__label--exam">Nome</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="paciente">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Idade</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="idade">—</output>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <span class="field__label field__label--exam">Tipo sanguíneo</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="tipoSanguineo">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Etnia</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="etnia">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Sexo biológico</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="sexo">—</output>
          </div>
        </div>

        <div class="exam-form__row exam-form__row--2">
          <div class="field">
            <span class="field__label field__label--exam">RG</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="rg">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">CPF</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="cpf">—</output>
          </div>
        </div>
      </fieldset>

      <fieldset class="exam-form__section">
        <legend class="exam-form__section-title">
          <img src="/imgs/clipboard-list-icon.svg" alt="" width="18" height="18">
          Dados do exame
        </legend>

        <div class="exam-form__row exam-form__row--3">
          <div class="field">
            <span class="field__label field__label--exam">Tipo de exame</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="tipoExame">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Data do exame</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="data">—</output>
          </div>
          <div class="field">
            <span class="field__label field__label--exam">Status</span>
            <output class="field__input field__input--exam exam-view__value" data-campo="status">—</output>
          </div>
        </div>
      </fieldset>

      <fieldset class="exam-form__section exam-form__section--upload">
        <legend class="exam-form__section-title">
          <img src="/imgs/image-icon.svg" alt="" width="18" height="18">
          Imagem anexada ao exame
        </legend>

        <a class="exam-view__image" id="exam-view-image-link" target="_blank" rel="noopener" title="Abrir imagem em nova aba">
          <img id="exam-view-image" alt="Radiografia anexada ao exame">
        </a>

        <p class="dropzone__status" id="exam-view-image-nome"></p>

        <%- include('analysis-alert') %>
      </fieldset>
    </div>

    <div class="exam-modal__footer">
      <p class="exam-modal__privacy">
        <img src="/imgs/shield-check-icon.svg" alt="" width="16" height="16">
        Dados fictícios • Documentos mascarados
      </p>
      <div class="exam-modal__actions">
        <button class="btn exam-modal__cancel" type="button" data-close-modal>Fechar</button>
        <button class="btn btn--primary exam-modal__submit" type="submit">Analisar exame</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  const examViewModal = document.getElementById('exam-view-modal');
  const examViewForm = examViewModal.querySelector('.exam-form');
  const examViewImage = document.getElementById('exam-view-image');
  const examViewImageLink = document.getElementById('exam-view-image-link');
  const examViewImageNome = document.getElementById('exam-view-image-nome');
  // Só existe quando a página voltou da rota /exames/analisar
  const analysisAlert = document.getElementById('analysis-alert');

  function abrirExame(exame) {
    if (analysisAlert) analysisAlert.hidden = analysisAlert.dataset.exameId !== exame.id;
    examViewForm.elements.id.value = exame.id;
    examViewForm.elements.paciente.value = exame.paciente;
    examViewForm.querySelectorAll('[data-campo]').forEach((campo) => {
      campo.textContent = exame[campo.dataset.campo] || '—';
    });
    examViewImageNome.textContent = exame.imagemNome ?? '—';
    examViewImage.src = exame.imagemUrl;
    examViewImageLink.href = exame.imagemUrl;
    examViewModal.showModal();
  }

  document.querySelectorAll('[data-exame]').forEach((linha) => {
    const exame = JSON.parse(linha.dataset.exame);
    linha.addEventListener('click', (event) => {
      if (event.target.closest('a')) return;
      abrirExame(exame);
    });

    if (analysisAlert && analysisAlert.dataset.exameId === exame.id) abrirExame(exame);
  });

  examViewModal.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => examViewModal.close());
  });

  examViewModal.addEventListener('click', (event) => {
    if (event.target === examViewModal) examViewModal.close();
  });
  examViewModal.addEventListener('close', () => examViewImage.removeAttribute('src'));
</script>
