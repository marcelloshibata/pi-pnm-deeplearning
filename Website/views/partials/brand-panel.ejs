<section class="brand-panel<%= typeof modifier !== 'undefined' ? ' ' + modifier : '' %>">
  <div class="brand">
    <span class="brand__icon"><img src="/imgs/lung-icon.svg" alt="" width="20" height="20"></span>
    <span class="brand__name">DPRT</span>
  </div>

  <div class="brand-panel__content">
    <p class="eyebrow"><%= eyebrow %></p>
    <h1 class="headline"><%- headline %></h1>
    <p class="brand-panel__text"><%= text %></p>
  </div>

  <div class="brand-panel__footer"></div>
</section>
