<dialog class="error-modal exam-modal report-modal" id="report-modal" aria-labelledby="report-modal-title" aria-describedby="report-modal-description">
  <form class="exam-form" action="/exames/relatorio" method="post">
    <input type="hidden" name="id">

    <div class="exam-modal__header patient-modal__header">
      <span class="patient-modal__icon">
        <img src="/imgs/clipboard-list-icon.svg" alt="" width="23" height="23">
      </span>
      <div class="patient-modal__heading">
        <h2 class="exam-modal__title" id="report-modal-title">Cadastrar relatório médico</h2>
        <p class="exam-modal__description" id="report-modal-description">Registre o diagnóstico e o parecer final do exame.</p>
      </div>
      <button class="exam-modal__close" type="button" aria-label="Fechar" data-close-modal>
        <img src="/imgs/x-icon.svg" alt="" width="18" height="18">
      </button>
    </div>

    <div class="exam-modal__body">
      <div class="report-form__summary">
        <div>
          <p class="report-form__summary-label">Paciente</p>
          <p class="report-form__summary-value report-form__summary-value--name" id="report-paciente"></p>
        </div>
        <div class="report-form__summary-end">
          <p class="report-form__summary-label">Exame vinculado</p>
          <p class="report-form__summary-value" id="report-exame"></p>
        </div>
      </div>

      <section class="exam-form__section">
        <div class="patient-form__heading">
          <h3 class="exam-form__section-title">Dados do relatório</h3>
          <p class="patient-form__required">* Campos obrigatórios</p>
        </div>

        <div class="report-form__row">
          <fieldset class="report-form__diagnosis">
            <legend class="field__label field__label--exam report-form__legend">Diagnóstico de pneumonia *</legend>
            <div class="report-form__choices">
              <label class="choice">
                <input class="choice__input" type="radio" name="diagnostico" value="sim" required>
                <span class="choice__mark"></span>
                Sim
              </label>
              <label class="choice">
                <input class="choice__input" type="radio" name="diagnostico" value="nao">
                <span class="choice__mark"></span>
                Não
              </label>
            </div>
            <p class="report-form__hint">Selecione uma opção conforme a avaliação clínica.</p>
          </fieldset>

          <div class="field">
            <label class="field__label field__label--exam" for="report-data">Data do relatório *</label>
            <input class="field__input field__input--exam field__input--date" type="date" id="report-data" name="dataRelatorio" required>
            <p class="report-form__hint report-form__hint--icon">
              <img src="/imgs/calendar-days-icon.svg" alt="" width="14" height="14">
              Informe a data de emissão.
            </p>
          </div>
        </div>

        <div class="field">
          <label class="field__label field__label--exam" for="report-parecer">Parecer final *</label>
          <textarea class="field__input field__input--exam report-form__textarea" id="report-parecer" name="parecer" placeholder="Descreva os achados do exame, a conclusão diagnóstica e as recomendações clínicas." maxlength="5000" required></textarea>
          <p class="report-form__hint">Utilize este espaço para registrar seu parecer completo, com todos os detalhes necessários.</p>
        </div>
      </section>
    </div>

    <div class="exam-modal__footer">
      <p class="exam-modal__privacy">
        <img src="/imgs/shield-check-icon.svg" alt="" width="16" height="16">
        Dados protegidos e acesso restrito à equipe assistencial.
      </p>
      <div class="exam-modal__actions">
        <button class="btn exam-modal__cancel" type="button" data-close-modal>Cancelar</button>
        <button class="btn btn--primary exam-modal__submit" type="submit">Salvar relatório</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  const reportModal = document.getElementById('report-modal');
  const reportForm = reportModal.querySelector('.exam-form');
  const reportData = document.getElementById('report-data');
  const reportParecer = document.getElementById('report-parecer');
  const reportTitle = document.getElementById('report-modal-title');
  const reportSubmit = reportModal.querySelector('.exam-modal__submit');
  // Data local no formato YYYY-MM-DD (toISOString usaria UTC e poderia adiantar o dia)
  const hojeIso = () => new Date().toLocaleDateString('en-CA');

  function abrirRelatorio(exame) {
    reportForm.elements.id.value = exame.id;
    document.getElementById('report-paciente').textContent = exame.paciente ?? '—';
    document.getElementById('report-exame').textContent = `${exame.tipoExame} • ${exame.data}`;

    const { relatorio } = exame;
    const somenteLeitura = relatorio !== null;

    reportTitle.textContent = somenteLeitura ? 'Relatório médico' : 'Cadastrar relatório médico';
    reportSubmit.hidden = somenteLeitura;
    reportForm.querySelectorAll('input:not([name="id"]), textarea').forEach((campo) => {
      campo.disabled = somenteLeitura;
    });

    if (somenteLeitura) {
      reportForm.elements.diagnostico.value = relatorio.diagnostico ? 'sim' : 'nao';
      reportData.value = relatorio.data_relatorio;
      reportParecer.value = relatorio.parecer;
    } else {
      reportData.max = hojeIso();
      reportData.value = hojeIso();
    }
    reportModal.showModal();
  }

  // Cada linha da tabela guarda os dados do exame em data-exame
  document.querySelectorAll('[data-open-report-modal]').forEach((button) => {
    const exame = JSON.parse(button.closest('[data-exame]').dataset.exame);
    button.addEventListener('click', (event) => {
      event.stopPropagation();
      abrirRelatorio(exame);
    });
  });

  reportModal.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => reportModal.close());
  });

  reportModal.addEventListener('click', (event) => {
    if (event.target === reportModal) reportModal.close();
  });

  reportModal.addEventListener('close', () => reportForm.reset());
</script>
