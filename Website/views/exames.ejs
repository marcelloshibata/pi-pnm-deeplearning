<%
  const exames = locals.exames || [];
  const pacientes = locals.pacientes || [];
  const resumo = locals.resumo || {};
  const totalExames = locals.totalExames || 0;
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { title: 'DPRT | Início' }) %>
</head>
<body class="dashboard-page">
  <header class="navbar">
    <a class="brand navbar__brand" href="/exames">
      <span class="brand__icon">
        <span class="navbar__logo"><img src="/imgs/lung-icon-blue.svg" alt="" width="19.7752" height="25.4075"></span>
      </span>
      <span class="brand__name">DPRT</span>
    </a>

    <nav class="navbar__links">
      <a href="/pacientes">Pacientes</a>
      <a href="/exames">Exames</a>
    </nav>

    <div class="navbar__profile">
      <button class="avatar" type="button" aria-label="Perfil<%= locals.usuario ? ' de ' + usuario.nome : '' %>">
        <img src="/imgs/user-icon.svg" alt="" width="18" height="18">
      </button>
    </div>
  </header>

  <main class="dashboard">
    <div class="page-heading">
      <h1 class="page-heading__title">Exames</h1>
      <p class="card__subtitle">Gerencie exames e acompanhe os resultados de cada paciente.</p>
    </div>

    <section class="summary-row">
      <article class="summary-card">
        <p class="summary-card__label">Exames cadastrados</p>
        <p class="summary-card__value"><%= resumo.exames ?? 0 %></p>
        <p class="summary-card__hint"><%= resumo.examesHint || '' %></p>
      </article>
      <article class="summary-card">
        <p class="summary-card__label">Pacientes ativos</p>
        <p class="summary-card__value"><%= resumo.pacientes ?? 0 %></p>
        <p class="summary-card__hint"><%= resumo.pacientesHint || '' %></p>
      </article>
      <article class="summary-card">
        <p class="summary-card__label">Imagens anexadas</p>
        <p class="summary-card__value"><%= resumo.imagens ?? 0 %></p>
        <p class="summary-card__hint"><%= resumo.imagensHint || '' %></p>
      </article>
    </section>

    <button class="btn btn--primary dashboard__new-exam" type="button" data-open-exam-modal>Novo exame</button>

    <section class="dashboard__main">
      <div class="card card--highlight">
        <div class="card__header">
          <div>
            <h2 class="card__title">Exames recentes</h2>
            <p class="card__subtitle">Resumo dos exames cadastrados com imagens anexadas</p>
          </div>
          <button class="pill pill--action" type="button">
            <img src="/imgs/download-icon.svg" alt="" width="16" height="16">
            Exportar
          </button>
        </div>

        <table class="exams-table">
          <colgroup>
            <col class="exams-table__col--patient">
            <col class="exams-table__col">
            <col class="exams-table__col">
            <col class="exams-table__col">
            <col>
          </colgroup>
          <thead>
            <tr>
              <th scope="col">Paciente</th>
              <th scope="col">Data</th>
              <th scope="col">Status</th>
              <th scope="col">Imagens</th>
              <th scope="col">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (exames.length === 0) { %>
              <tr>
                <td class="exams-table__empty" colspan="5">Nenhum exame cadastrado ainda.</td>
              </tr>
            <% } %>
            <% exames.forEach((exame) => { %>
              <tr class="exams-table__row" data-exame="<%= JSON.stringify(exame) %>">
                <td>
                  <p class="exams-table__name"><%= exame.paciente %></p>
                  <p class="exams-table__meta"><%= exame.idade %> anos • <%= exame.sexo %></p>
                </td>
                <td><%= exame.data %></td>
                <td>
                  <span class="chip<%= exame.pendente ? ' chip--warning' : '' %>"><%= exame.status %></span>
                </td>
                <td>
                  <span class="pill"><%= exame.imagens %> <%= exame.imagens === 1 ? 'anexo' : 'anexos' %></span>
                </td>
                <td>
                  <div class="exams-table__actions">
                    <button class="pill" type="button" data-open-report-modal>
                      <%= exame.relatorio ? 'Visualizar relatório' : 'Registrar relatório' %>
                    </button>
                    <a class="pill" href="#">Editar</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="card__footer">
          <p class="card__subtitle">Mostrando <%= exames.length %> de <%= totalExames %> exames</p>
          <div class="card__pagination">
            <button class="pill pill--white" type="button" disabled>Anterior</button>
            <button class="pill pill--white" type="button" disabled>Próxima</button>
          </div>
        </div>
      </div>

      <div class="card card--patients">
        <div class="card__header">
          <div>
            <h2 class="card__title">Histórico de pacientes</h2>
            <p class="card__subtitle">Últimos pacientes com exames registrados</p>
          </div>
          <a class="pill pill--header" href="#">Ver todos</a>
        </div>

        <ul class="patient-list">
          <% if (pacientes.length === 0) { %>
            <li class="patient-list__empty">Nenhum paciente registrado ainda.</li>
          <% } %>
          <% pacientes.forEach((paciente) => { %>
            <li class="patient-row">
              <span class="patient-row__initials"><%= paciente.iniciais %></span>
              <div class="patient-row__info">
                <p class="exams-table__name"><%= paciente.nome %></p>
                <p class="exams-table__meta"><%= paciente.totalExames %> <%= paciente.totalExames === 1 ? 'exame' : 'exames' %> • Último em <%= paciente.ultimoExame %></p>
              </div>
              <span class="chip"><%= paciente.status %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
  </main>

  <%- include('partials/new-exam-modal') %>
  <%- include('partials/exam-view-modal') %>
  <%- include('partials/report-modal') %>
  <%- include('partials/error-modal') %>
</body>
</html>
